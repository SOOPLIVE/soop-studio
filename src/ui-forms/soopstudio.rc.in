1 VERSIONINFO
FILEVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "SOOP Co., Ltd."
      VALUE "FileDescription", "FreecShot Plus"
      VALUE "FileVersion", "${UI_VERSION}"
      VALUE "InternalName", "soopstudio"
      VALUE "OriginalFilename", "SoopStudio.exe"
      VALUE "ProductName", "FreecShot Plus"
      VALUE "ProductVersion", "${UI_VERSION}"
      VALUE "Comments", "Free and open source software for video recording and live streaming"
      VALUE "LegalCopyright", "Copyright (c) SOOP Co., Ltd. All rights reserved."
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
