	color: rgba(255, 255, 255, 80%);
}

AFQStudioSettingDialog #titleButton[hover="false"]:checked,
AFQStudioSettingDialog #titleButton[hover="true"]:checked {
	color: palette(light);
	font-weight: 700;
}

AFQSettingTabButton,
