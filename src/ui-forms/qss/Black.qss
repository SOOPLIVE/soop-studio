}

AFAudioMixerWidget #vMixerScrollArea QScrollBar:horizontal {
    background-color: transparent;
	border: 0px solid transparent;
    height: 4px;	
}

AFAudioMixerWidget #hMixerScrollArea QScrollBar::handle:vertical,
AFAudioMixerWidget #vMixerScrollArea QScrollBar:handle:horizontal {
	border-radius: 2px;
}

MuteCheckBox {
	background-color: transparent;
}

MuteCheckBox::indicator:checked:enabled {
	image: url(../assets/audio-mixer-block/audio_mixer_volume_mute.svg);
}

MuteCheckBox::indicator:checked:hover {
	image: url(../assets/audio-mixer-block/audio_mixer_volume_mute_hover.svg);
}

MuteCheckBox::indicator:checked:pressed {
	image: url(../assets/audio-mixer-block/audio_mixer_volume_mute_pressed.svg);
}

MuteCheckBox::indicator:unchecked:enabled {
	image: url(../assets/audio-mixer-block/audio_mixer_volume.svg);
}

MuteCheckBox::indicator:unchecked:hover {
	image: url(../assets/audio-mixer-block/audio_mixer_volume_hover.svg);
}

MuteCheckBox::indicator:unchecked:pressed {
	image: url(../assets/audio-mixer-block/audio_mixer_volume_pressed.svg);
}

MuteCheckBox::indicator:indeterminate {
    image: url(../assets/audio-mixer-block/audio_mixer_volume_unassigned.svg);
}

AFCVolumeSlider::groove:horizontal {
	background-color: #17191C;
	height: 2px;
	border: 1px;
	border-radius: 1px;
}

AFCVolumeSlider::groove:vertical { 
	background-color: #17191C;
	width: 2px;
	border: 1px;
	border-radius: 1px;
}

AFCVolumeSlider::handle:horizontal {
	height: 0px;
	width: 0px;
	image: none;
	background: none;
	margin: 0px 0px;
}

AFCVolumeSlider[hover="true"]::handle:horizontal {
	height: 10px;
	width: 10px;
	image: url(../assets/audio-mixer-block/audio_mixer_slider_handle.svg);
	margin: -8px 0px;
}

AFCVolumeSlider::handle:vertical {
	height: 0px;
	width: 0px;
	image: none;
	background: none;
	margin: 0px 0px;
}

AFCVolumeSlider[hover="true"]::handle:vertical {
	height: 11px;
	width: 13px;
	image: url(../assets/audio-mixer-block/audio_mixer_slider_handle.svg);
	margin: 0px -4px;
}

/*AFCVolumeSlider::handle:horizontal:disabled,
AFCVolumeSlider::handle:vertical:disabled {
	image: url(../assets/audio-mixer-block/audio_mixer_slider_handle_disabled.svg);
}

AFCVolumeSlider::handle:horizontal:hover,
AFCVolumeSlider::handle:vertical:hover {
	image: url(../assets/audio-mixer-block/audio_mixer_slider_handle_hover.svg);
}*/

AFCVolumeSlider::sub-page:horizontal,
AFCVolumeSlider::add-page:vertical,
AFCVolumeSlider::sub-page:horizontal:disabled,
AFCVolumeSlider::add-page:vertical:disabled { 
	background-color: #A7A9AB;
	border-radius: 1px;
}

AFCVolumeSlider[hover="true"]::sub-page:horizontal,
AFCVolumeSlider[hover="true"]::add-page:vertical { 
	background-color: #D3D4D5;
	border-radius: 1px;
}

/* Advance Controls Dock */
AFAdvanceControlsWidget QLabel {
	color: rgb(255, 255, 255);
}

AFAdvanceControlsWidget QLabel:disabled {
	color: rgba(255, 255, 255, 20%);
}

AFAdvanceControlsWidget QWidget[AdvControlWdtPressed="false"] {
	background-color: rgba(255, 255, 255, 7%);
	border-radius: 4px;
}

AFAdvanceControlsWidget QWidget[AdvControlWdtPressed="false"]:hover {
    background-color: rgba(255, 255, 255, 14%);
}


AFAdvanceControlsWidget QWidget[AdvControlWdtPressed="false"]:disabled,
AFAdvanceControlsWidget QWidget[AdvControlWdtPressed="true"] {
    background-color: rgba(255, 255, 255, 1.4%);
}

/* Advance Control Mode Icon */
AFAdvanceControlsWidget QLabel[AdvControlWdtStyle="studioMode"] {
	background-color: transparent; 
	border-image: url("../assets/advance-controls-block/basic-mode.svg") 0 0 0 0 stretch stretch;
}

