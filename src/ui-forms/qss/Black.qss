	border-bottom : none;
}

AFQProgramInfoDialog #pushButton_PrivacyPolicy,
AFQProgramInfoDialog #pushButton_TermsConditions,
AFQProgramInfoDialog #pushButton_OpenSourceLicense {
	background-color: palette(window);
