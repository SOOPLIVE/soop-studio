/* Advanced Audio Setting */
AFQAudioAdvSettingDialog QLabel {
	color: rgba(255, 255, 255, 80%);
	font-size: 14px;
}

AFQAudioAdvSettingDialog QLabel:disabled {
	color: rgba(255, 255, 255, 20%);
}

AFQAudioAdvSettingDialog #audioTracks,
AFQAudioAdvSettingDialog #balance,
AFQAudioAdvSettingDialog #monitoring,
AFQAudioAdvSettingDialog #mono,
AFQAudioAdvSettingDialog #name,
AFQAudioAdvSettingDialog #status,
AFQAudioAdvSettingDialog #syncOffset,
AFQAudioAdvSettingDialog #volume {
	font-weight: 700;
}

AFQAudioAdvSettingDialog #activeOnly {
	margin: 10px 0px 10px 10px;
}

AFQAudioAdvSettingDialog QSlider::groove:horizontal {
    background: palette(base);
	height: 4px;
	border-radius: 2px;
}

AFQAudioAdvSettingDialog QSlider::handle:horizontal {
	background: palette(midlight);
    height: 10px;
    width: 10px;
    border-radius: 5px;
    margin: -3px 0px;
}

AFQAudioAdvSettingDialog QSlider::handle:horizontal:disabled {
	background: none;
    height: 0px;
    width: 0px;
    margin: 0px;
}

AFQAudioAdvSettingDialog QSlider::add-page {
	background: palette(base);
	border-radius: 2px;
}

AFQAudioAdvSettingDialog QSlider::sub-page {
	background: palette(light);
	border-radius: 2px;
}

AFQAudioAdvSettingDialog QSlider::sub-page:disabled {
	background: none;
