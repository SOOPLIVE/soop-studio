    background-color: transparent;
	border: 0px solid transparent;
    width: 4px;	
}

AFQLeftNavigationBar #scrollArea_Channel QScrollBar:horizontal {
    background-color: transparent;
	border: 0px solid transparent;
    height: 4px;	
}

AFQLeftNavigationBar #scrollArea_Channel QScrollBar::handle:vertical {
	border-radius: 2px;
}

AFQLeftNavigationBar #scrollAreaWidgetContents_Channel{
	background-color: #24272D;
}

AFQLeftNavigationBar #widget_Block{
	background-color: #24272D;
	border-right: 1px solid black;
	border-top: 1px solid #141414;
}

AFQLeftNavigationBar #favoriteMenuEmpty {
	background-color : transparent;
	image: url("../assets/mainview/leftsidebar/bt_empty_favorite_default.svg");
}

AFQLeftNavigationBar #favoriteMenuEmpty:hover {
	image: url("../assets/mainview/leftsidebar/bt_empty_favorite_hover.svg");
}

AFQLeftNavigationBar #mainChannelButton_2 {
	background-color : transparent;
	image: url("../assets/mainview/leftsidebar/bt_leftbar_favorite_setting_default.svg");
}

AFQLeftNavigationBar #mainChannelButton_2:hover {
	image: url("../assets/mainview/leftsidebar/bt_leftbar_favorite_setting_hover.svg");
}

AFQLeftNavigationBar #favoriteMenuFrame { 
	background-color : #24272D;
	border-right : 1px solid black;
}

AFQLeftNavigationBar #emptyFrame {
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	background-color : #2D3035;
}

AFQLeftNavigationBar #scrollAreaWidgetContents {
	background-color : #2D3035;
}

AFQLeftNavigationBar #frame {
	background-color : #2D3035;
	border-top : 1px solid #24272D;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

AFQLeftNavigationBar QScrollArea {
	background-color: #2D3035;
	border : none;
}

AFQLeftNavigationBar QScrollBar:vertical {
    background-color: transparent;
	border: 0px solid transparent;
    width: 2px;	
}

AFQLeftNavigationBar QScrollBar:horizontal {
    background-color: transparent;
	border: 0px solid transparent;
    height: 2px;	
}

AFQLeftNavigationBar QScrollBar::handle:vertical {
