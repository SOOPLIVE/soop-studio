/* Tab Widget */
QTabBar::tab {
    background: #1D1F24;
	min-height: 32px;
	max-height: 32px;
	color:#9196A1;
	
}

QTabBar::tab:pressed {
    background: #24272D;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 20%);
    color: rgba(255, 255, 255, 70%);
}

QTabBar::tab:selected {
    background: #24272D;
    color: #0182FF;
}

QTabWidget::pane {
    border: none;
}

/* YouTube Integration */
AFQYouTubeSettingDialog {
    qproperty-thumbPlaceholder: url(./Dark/sources/image.svg);
}

AFQYouTubeSettingDialog QPlainTextEdit {
    background-color: rgba(0, 0, 0, 20%);
	border: none;
	border-radius: 4px;
	padding: 10px;
    padding-left: 12px;
}

