	background-color: transparent;
}

QPushButton[buttonType="AudioList"][isShow="false"]{
	image: url("../assets/block-icon/popup/default/audiolist.svg");
	background-color: transparent;
}

QPushButton[buttonType="AudioList"][isShow="true"]{
	image: url("../assets/block-icon/popup/clicked/audiolist.svg");
	background-color: transparent;
}

QPushButton[buttonType="Savvy"][isShow="false"]{
	image: url("../assets/block-icon/popup/default/savvy.svg");
	background-color: transparent;
}

QPushButton[buttonType="Savvy"][isShow="true"] {
	image: url("../assets/block-icon/popup/active/savvy.svg");
	background-color: transparent;
}

QPushButton[buttonType="SceneSource"] {
	image: url("../assets/block-icon/popup/default/scenesource.svg");
}

QPushButton[buttonType="SceneSource"]:pressed {
	image: url("../assets/block-icon/popup/clicked/scenesource.svg");
}

QPushButton[buttonType="AudioMixer"] {
	image: url("../assets/block-icon/popup/default/audiomixer.svg");
}

QPushButton[buttonType="AudioMixer"]:pressed {
	image: url("../assets/block-icon/popup/clicked/audiomixer.svg");
}

QPushButton[buttonType="NewsFeed"] {
