}

QPushButton[buttonType="settingDialog"] {
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 10%);
    color:rgba(255, 255, 255, 80%);
    font-size:15px;
	font-weight: 500;
}

QPushButton[buttonType="settingDialog"]:hover {
    background-color: rgba(255, 255, 255, 17%);
}

QPushButton[buttonType="settingDialog"]:disabled {
    background-color: rgba(255, 255, 255, 2%);
    color:rgba(255, 255, 255, 16%);
}

/* Popup Title Frame */
QDialog #titleFrame {
	border-top : none;
	border-bottom : 1px solid #111;
	border-left : none;
	border-right : none;
}

QDialog #bottomFrame {
	border: none;
}

/* Scene Select Dialog */
AFQSceneSelectDialog #labelInfo {
	font-size:18px;
	color:rgba(252, 252, 253, 100%);
}

AFQSceneSelectDialog QListWidget {
    border-radius: 4px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 100%);
}

AFQSceneSelectDialog QListWidget::item {
    padding: 6px;
	height : 28px;
    border-radius: 4px;
	border: 0px solid transparent;
    color: rgba(213, 215, 220, 100%);
    background-color: rgba(0, 0, 0, 100%);
}

AFQSceneSelectDialog QListWidget::item:selected {
    color: rgba(213, 215, 220, 100%);
    background-color: rgba(29, 31, 36, 100%);
}


/* Select Source */
AFQSelectSourceDialog #emptySourceFrame,
AFQSelectSourceDialog #frameSourceInfo {
	background-color: rgba(0, 0, 0, 20%);
	border-bottom-left-radius: 10px;
}

AFQSelectSourceDialog #sourceTypeButtonFrame {
	border : none;	
}

AFQSelectSourceDialog #emptyFrame_2,
AFQSelectSourceDialog #emptyFrame_3 {
	border : none;
	border-bottom: 1px solid #3A3D42;
}


AFQSelectSourceDialog #label_SourceName {
	color: rgba(255, 255, 255, 90%);
	text-align: center;
	font-size: 20px;
	font-weight: 700;
}

AFQSelectSourceDialog #labelSourceInfo {
	color: #9196A1;
}

AFQSelectSourceDialog #pushButton_SoopSourceInfo {
	font-size : 12px;
