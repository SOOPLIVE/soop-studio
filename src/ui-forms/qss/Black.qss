}

/* Scene Source Dock */
AFQSceneListItem,
AFQSceneBottomButton {
	font-size : 14px;
	background-color: palette(window);
	border-color:palette(window);
	border-radius: 5px;
}

AFQSceneBottomButton {
	border: 1px solid palette(mid);
}

AFQSceneListItem[sceneBtnType='selected'] {
	font-weight:500;
	border-top-right-radius: 0px;
	border-bottom-right-radius: 0px;
	border-top-left-radius: 4px;
	border-bottom-left-radius: 4px;	
	background-color: #191B20;
}

AFQSceneBottomButton[sceneBtnType='selected'] {
	border-radius: 5px;
	border: none;
	background-color: rgba(0, 224, 255, 10%);
}

AFQSceneListItem[sceneBtnType='idle'] {
	background-color: palette(window);
}

AFQSceneListItem[sceneBtnType='hover'] {
	background-color: #33363C;
}

AFQSceneBottomButton[sceneBtnType='']:hover {
	background-color: #33363c;
	border: none;
}

AFQSceneBottomButton #sceneButtonIndex, AFQSceneBottomButton #sceneButtonName {
    font-size : 14px;
}

AFQSceneBottomButton #sceneButtonIndex[selected='true'], AFQSceneBottomButton #sceneButtonName[selected='true'] {
	color: palette(light)
}

AFQSceneBottomButton #sceneButtonIndex[selected='false'], AFQSceneBottomButton #sceneButtonName[selected='false'] {
	color: #757B8A;
}

AFQSceneBottomButton #frameMiddleLine[selected='true'] {
	background-color : #165A82;
}

AFQSceneBottomButton #frameMiddleLine[selected='false'] {
	background-color : #3A3D42;
}

AFQSceneListItem #label_SceneIndex {
	font-size : 13px;
	padding: 3px 3px 4px 3px;
	border-radius: 2px;
	border : 1px solid rgba(58, 61, 66, 100%);
	color : palette(midlight);
}

#label_ScreenShotScene {
	border: 1px solid palette(light);
}

AFQSceneListItem #label_SceneName {
	font-size: 13px;
	padding: 2px 0px 4px 0px;
}

AFQSceneListItem #label_SceneName[selected='false'] {
	color : palette(text);
	font-weight:400;
}

AFQSceneListItem #label_SceneName[selected='true'] {
	color : palette(midlight);
	font-weight:500;
}

QPushButton#favoriteSceneButton { 
	background-color: transparent;
	border:none;
    image: url(../assets/scene-source-block/scene-list-icon/ic_favorite_off.svg);
}

QPushButton#favoriteSceneButton:checked { 
    image: url(../assets/scene-source-block/scene-list-icon/ic_favorite_on.svg);	
}


QLineEdit#sceneNameEdit {
    background-color: palette(window);
	border: 0px solid palette(window);
    padding-left: 0px;
    border-radius: 0px;
}

QFrame#sourceToolBarFrame {
	border-top: 1px solid palette(window);
	background-color: #181B20;
	border-bottom-left-radius: 6px;
	border-bottom-right-radius: 6px;
}

/* 4px width Scroll */
AFQProgramSettingAreaWidget QScrollBar:vertical,
AFQVideoSettingAreaWidget QScrollBar:vertical,
AFQAudioSettingAreaWidget QScrollBar:vertical,
AFQStreamSettingAreaWidget QScrollBar:vertical,
AFQHotkeySettingAreaWidget QScrollBar:vertical,
AFQOutputSettingAreaWidget QScrollBar:vertical,
AFQAccessibilitySettingAreaWidget QScrollBar:vertical,
AFQAdvancedSettingAreaWidget QScrollBar:vertical,
AFQListViewScrollArea QScrollBar:vertical,
AFQSourceListView QScrollBar:vertical,
AFQCustomFontDialog QScrollBar:vertical {
    border: 2px solid grey;
    background-color: transparent;
	border: 0px solid transparent;
    width: 4px;	
}

AFQProgramSettingAreaWidget QScrollBar::handle:vertical,
AFQVideoSettingAreaWidget QScrollBar::handle:vertical,
AFQAudioSettingAreaWidget QScrollBar::handle:vertical,
AFQStreamSettingAreaWidget QScrollBar::handle:vertical,
AFQHotkeySettingAreaWidget QScrollBar::handle:vertical,
AFQOutputSettingAreaWidget QScrollBar::handle:vertical,
AFQAccessibilitySettingAreaWidget QScrollBar::handle:vertical,
AFQAdvancedSettingAreaWidget QScrollBar::handle:vertical,
AFQListViewScrollArea QScrollBar::handle:vertical,
AFQSourceListView QScrollBar::handle:vertical,
AFQCustomFontDialog QScrollBar::handle:vertical {
	border-radius: 2px;
}

AFQSourceListView {
	border-top-left-radius: 0px;
	border-top-right-radius: 6px;
	border: 1px solid #191B20;
	background-color: #191B20;
	padding-top: 10px;
	padding-left: 10px;
	padding-right: 10px;
	font-size: 14px;
}

AFQSourceListView::item {
    border-radius: 4px;
    color: palette(text);
	border: none;
	outline: none;
}

AFQSourceListView::item:hover,
AFQSourceListView::item:selected:hover {
	background-color: #36383E;
}

/* Source ListView Group Expand Button */
#expandCheckBox::indicator:unchecked,
#expandCheckBox::indicator:unchecked:enabled {
    image: url(../assets/scene-source-block/source-list-icon/bt_group_expand.svg);
}

#expandCheckBox::indicator:checked,
#expandCheckBox::indicator:checked:enabled {
    image: url(../assets/scene-source-block/source-list-icon/bt_group_unexpand.svg);
}


/* Label warning/error */
QLabel#warningLabel {
    color: rgb(192,128,0);
    font-weight: bold;
}

QLabel#errorLabel {
    color: rgb(192,0,0);
    font-weight: bold;
}

#visibleCheckBox:indicator:checked,
#visibleCheckBox:indicator:checked:enabled, 
