/* Source ToolBar */
CBaseSourceToolbar QComboBox {
	height : 30px;
}

CBaseSourceToolbar QComboBox::drop-down {
	width: 40px;
	height: 30px;
	background-color: transparent;
}

QComboBox::down-arrow {
	width: 16px;
	height: 16px;
	padding: 6px;
}


/* MainDynamicComposit */
#AFMainDynamicComposit #centralwidget {
	background-color: palette(dark);
}


/* Source ToolBar - Check Common QCombox qss*/
#AFMainDynamicComposit #contextContainer {
	background-color: palette(window);
	border-radius: 6px;
	color : #D5D7DC;
}

#contextContainer QPushButton {
	background-color : #31343A;
	color : #D5D7DC;
	padding-left : 10px;
	padding-right : 10px;
}

#contextContainer QPushButton:hover {
	background-color: rgba(255, 255, 255, 11%);
}

#contextContainer QPushButton:pressed,
#contextContainer QPushButton:disabled {
	background-color : #2D3035;
}

#AFMainDynamicComposit #contextContainer QComboBox {
	background-color : rgba(49, 52, 58, 100%);
}

#AFMainDynamicComposit #contextContainer QComboBox:hover {
	background-color: rgba(255, 255, 255, 11%);
}

#AFMainDynamicComposit #contextContainer QComboBox:disabled{
	background-color: rgba(255, 255, 255, 1.8%);
}

#AFMainDynamicComposit #contextContainer QComboBox:on {
	border: 1px solid #191919;
	background-color: rgba(255, 255, 255, 6%);
	border-bottom-left-radius: 0px;
	border-bottom-right-radius: 0px;
	color: rgba(255, 255, 255, 40%);
}

#AFMainDynamicComposit #contextContainer QComboBox::drop-down {
	width: 30px;
	height: 30px;
	background-color: transparent;
}

#AFMainDynamicComposit #contextContainer QComboBox::down-arrow {
	width: 16px;
	height: 16px;
	padding: 7px;
}

#AFMainDynamicComposit #contextContainer QComboBox::down-arrow:enabled {
	image: url(../assets/common-component/default/combobox_dropdown_toolbar.svg);
}

#AFMainDynamicComposit #contextContainer QComboBox::down-arrow:disabled {
	image: url(../assets/common-component/disable/combobox_dropdown_toolbar.svg);
}

#AFMainDynamicComposit #contextContainer #sourcePropertiesButton {
    icon-size: 16px, 17px;
}

#AFMainDynamicComposit #contextContainer #sourcePropertiesButton:disabled {
	background-color: #202328;
	color : #757B8A;
}

#AFMainDynamicComposit #contextContainer #sourceInteractButton {
    qproperty-icon: url("../assets/source-toolbar/bt_intract.svg");
    icon-size: 16px, 17px;
}

#AFMainDynamicComposit #contextContainer #pushButton_Refresh {
    qproperty-icon: url("../assets/source-toolbar/bt_refresh.svg");
    icon-size: 16px, 17px;
}

QMainWindow::separator {
	width: 8px;
	background-color: transparent;
}

/* Main Account Button */
AFMainAccountButton {
    border-radius: 8px;
    background: transparent;
    border: none;
}

AFMainAccountButton:hover,
AFMainAccountButton[disable="true"]:hover,
AFMainAccountButton[leftSideBar="true"]:checked {
    background: transparent;
}

AFMainAccountButton[leftSideBar="true"]:hover {
    background: #3A3D42;
}

AFMainAccountButton #pushButton_Frame {
    background: transparent;
}

AFMainAccountButton #pushButton_Frame[live="true"][streaming="true"] {
	image: url(../assets/platform/broad-ellipse.svg);
}

AFMainAccountButton #pushButton_Frame[live="true"][streaming="false"] {
	image: url(../assets/platform/standby-ellipse.svg);
}

AFMainAccountButton #pushButton_Platform {
	border-radius: 14px;
	background: transparent;
}

/* Left Navigation Bar */
AFQLeftNavigationBar {
	background-color: #24272D;
	border-right: 1px solid black;
}

AFQLeftNavigationBar QPushButton{
	background-color: transparent;
	padding-top:0px;
	line-height: 50%;
}

AFQLeftNavigationBar QPushButton[buttonType="addPlatform"]:hover {
