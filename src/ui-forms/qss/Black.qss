SOOPThemeMeta {
    dark: 'true';
    author: '';
}

/* Color Palette */
SOOPTheme {
    window: #24272D;
	
	/*text: rgba(255, 255, 255, 60%);*/
	text: #D5D7DC;
	base: #1d1f24;
	
	light: #00A3FF;
	midlight: white;
	mid: #3a3d42;
	dark: #111111;
	shadow: #191b20;

	highlight: rgba(0, 163, 255, 100%);
}

QWidget {
    font-family: 'Noto Sans KR';
	font-size: 13px;
	font-weight: 400;
	color: palette(text);
}

QWidget::disabled {
	color: rgba(255, 255, 255, 18%);
}

QDockWidget {
	border: 1px solid palette(dark);
}

AFTTopBaseDialog {
	border: 1px solid palette(dark);
}

/* Default QMessageBox */
QMessageBox {
	border: 1px solid palette(dark);
	background-color: palette(window);
	color: #D5D7DC;
	font-size: 17px;
	font-weight: 600;
}

/* Common QListWidget */
QListWidget {
    border-radius: 4px;
    padding: 3px;
    background-color: palette(base);
}

QListWidget::item {
    padding: 6px;	
    border-radius: 4px;
	border: 0px solid transparent;
    background-color: palette(base);
}

QListWidget::item:selected {
    color: palette(text);
    background-color: rgb(40, 42, 47);
}

QListWidget::item:hover,
QListWidget::item:selected:hover {
    color: palette(text);
    background-color: #505257;
}

QListWidget::item:disabled,
QListWidget::item:disabled:hover {
    color: rgba(255, 0, 0, 60%);
    background-color: palette(base);
}

/* Common QToolTip */
QToolTip {
	padding: 2px;
    color: rgba(255, 255, 255, 90%);
	border: 1px solid palette(mid);
	background-color: palette(window);
}

/* Common QMenu */
QMenu {
    padding-left: 0px;
    padding-right: 0px;
    padding-bottom: 10px;
    padding-top: 10px;
	border: 1px solid palette(dark);
}

QMenu::separator {
    background: #16171b;
    height: 1px;
}

QMenu::item:disabled {
    color: rgb(153, 153, 153);
    background: transparent;
}

QMenu::right-arrow {
    image: url(../assets/menu-spread.svg);
    padding-right: 6px;
}

QMenu::item {
    padding-left: 10px;
    padding-right: 20px;
    padding-bottom: 6px;
    padding-top: 6px;
	color: rgba(255, 255, 255, 80%);
	font-size: 14px;
	border-radius: 4px;
}

QMenu::item:selected,
QMenu::item:hover,
QMenu::item:selected:hover {
	background-color: rgba(255, 255, 255, 10%);
}

QMenu::item:disabled {
	color: #474a4f;
}

QMenu::indicator {
	width: 14px;
	height: 14px;
    margin : 0px 0px 0px 10px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url("");
}

QMenu::indicator:non-exclusive:checked {
    image: url(../assets/mainview/menu-checked.svg);
}

/* Common QLineEdit */
QLineEdit {
	border: none;
    border-radius: 4px;
    background-color: palette(base);
    padding-left: 12px;
}

QLineEdit:hover {
    background-color: palette(base);
}

QLineEdit:focus {
	background-color: palette(base);
    border: 1px solid #0182FF;
	padding-left: 11px;
}

/* Common QScrollBar */
QScrollBar {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    width: 6px;
}

QScrollBar:horizontal {
    height: 6px;	
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #697176;
	border-radius: 3px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #808287;
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
	background-color: #31343A;
}

QScrollBar::up-arrow:vertical, QScrollBar::up-arrow:horizontal,
QScrollBar::down-arrow:vertical, QScrollBar::down-arrow:horizontal,
QScrollBar::add-page:vertical, QScrollBar::add-page:horizontal,  
QScrollBar::sub-page:vertical, QScrollBar::sub-page:horizontal {
	background: none;
}

QScrollBar::add-line:vertical, QScrollBar::add-line:horizontal {
	border: none;
	width: 0px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical, QScrollBar::sub-line:horizontal {
	border: none;
	width: 0px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::handle:vertical[transparent="true"]{
	background-color: transparent;
}

QScrollBar::handle:horizontal[transparent="true"]{
	background-color: transparent;
}

/* Common QSlider */
QSlider::groove:horizontal {
	height: 4px;
	border: 1px;
	background-color: rgba(0, 0, 0, 100%);
	border-radius: 1px;
}


QSlider::handle:horizontal {
	height: 10px;
	width: 10px;
	image: url(../assets/common-component/default/slider_handle.svg);
	background-color: palette(midlight);
	background: none;
	margin: -8px 0px;
}

QSlider::sub-page:horizontal { 
	background-color: #0182FF; 
	border-radius: 2px;
}


QSlider::groove:horizontal:disabled {
	background-color: rgba(255,255,255,20%); 
}

QSlider::sub-page:horizontal:disabled { 
	background-color: rgba(255,255,255,20%); 
}

QSlider::handle:horizontal:disabled {
	background-color: rgba(255,255,255,20%); 
	height: 0px;
	width: 0px;
	image: none;
}

QSlider::sub-page:horizontal { 
	background-color: #0182FF; 
	border-radius: 2px;
}

/* Common QCheckBox */
QCheckBox {
	font-size: 14px;
}

QCheckBox::indicator:unchecked:enabled {
	image: url(../assets/common-component/default/checkbox_unchecked.svg);
}

QCheckBox::indicator:unchecked:hover {
	image: url(../assets/common-component/mousehover/checkbox_unchecked.svg);
}

QCheckBox::indicator:unchecked:disabled {
	image: url(../assets/common-component/disable/checkbox_unchecked.svg);
}

QCheckBox::indicator:checked:enabled {
	image: url(../assets/common-component/default/checkbox_checked.svg);
}

QCheckBox::indicator:checked:hover {
	image: url(../assets/common-component/mousehover/checkbox_checked.svg);
}

QCheckBox::indicator:checked:disabled {
	image: url(../assets/common-component/disable/checkbox_checked.svg);
}

/* Common QSpinBox, QDoubleSpinBox */
QSpinBox, QDoubleSpinBox {
    padding-left: 12px;
    padding-right: 30px;
	border-radius: 4px;
	background-color: palette(base);
	color : #D5D7DC;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
	background-color : #1D1F24;
	color : #757B8A;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
	width: 16px;
	height: 16px;
    border-width: 1px;
	right: 12px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
	bottom: 4px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
	top: 4px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
	background-color: transparent;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed {
	background-color: transparent;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
	width: 16px;
}

QSpinBox::up-arrow:enabled, QDoubleSpinBox::up-arrow:enabled {
    image: url(../assets/common-component/default/spinbox_up.svg);
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:pressed, QDoubleSpinBox::up-arrow:pressed {
	image: url(../assets/common-component/disable/spinbox_up.svg);
}

QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
	image: url(../assets/common-component/mousehover/spinbox_up.svg);
}

QSpinBox::down-arrow:enabled, QDoubleSpinBox::down-arrow:enabled {
    image: url(../assets/common-component/default/spinbox_down.svg);
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:pressed, QDoubleSpinBox::down-arrow:pressed  {
	image: url(../assets/common-component/disable/spinbox_down.svg);
}

QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
	image: url(../assets/common-component/mousehover/spinbox_down.svg);
}

/* Common QSpinBox, QDoubleSpinBox Type 2 (PlusMinus Button Shape) */
QSpinBox[spinBoxType="plusMinusButtonType"], QDoubleSpinBox[spinBoxType="plusMinusButtonType"] {
	color: #D5D7DC;
    padding-left: 12px;
	border-radius: 4px;
	background-color: #36383E;
}

QSpinBox[spinBoxType="plusMinusButtonType"]:disabled, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]:disabled {
	background-color: #282A30;
	color: #474A50;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::up-button, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-button,
QSpinBox[spinBoxType="plusMinusButtonType"]::down-button, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-button {
	width: 30px;
	height: 19px;
	right: 0px;
	background-color: #505257;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::up-button, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-button {
    border-top-right-radius: 4px;
	top: 0px;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::down-button, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-button {
	border-bottom-right-radius: 4px;
	bottom: 0px;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::up-button:hover, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-button:hover {
	background-color: rgba(255, 255, 255, 20%);
	border-radius: 0px;
	border-top-right-radius: 4px;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::down-button:hover, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-button:hover {
	background-color: rgba(255, 255, 255, 20%);
	border-radius: 0px;
	border-bottom-right-radius: 4px;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::down-button:disabled, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-button:disabled,
QSpinBox[spinBoxType="plusMinusButtonType"]::down-button:pressed, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-button:pressed {
	background-color: #2D3035;
	border-radius: 0px;
	border-top-right-radius: 4px;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::up-button:disabled, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-button:disabled,
QSpinBox[spinBoxType="plusMinusButtonType"]::up-button:pressed, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-button:pressed {
	background-color: #2D3035;
	border-radius: 0px;
	border-bottom-right-radius: 4px;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::up-arrow, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-arrow,
QSpinBox[spinBoxType="plusMinusButtonType"]::down-arrow, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-arrow {
	width: 16px;
	height: 16px;
}

QSpinBox[spinBoxType="plusMinusButtonType"]::up-arrow:enabled, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-arrow:enabled {
    image: url(../assets/common-component/default/spinbox_up_plus.svg);
}

QSpinBox[spinBoxType="plusMinusButtonType"]::up-arrow:disabled, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::up-arrow:disabled {
	image: url(../assets/common-component/disable/spinbox_up_plus.svg);
}

QSpinBox[spinBoxType="plusMinusButtonType"]::down-arrow:enabled, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-arrow:enabled {
    image: url(../assets/common-component/default/spinbox_down_minus.svg);
}

QSpinBox[spinBoxType="plusMinusButtonType"]::down-arrow:disabled, QDoubleSpinBox[spinBoxType="plusMinusButtonType"]::down-arrow:disabled {
	image: url(../assets/common-component/disable/spinbox_down_minus.svg);
}

/* Common QSpinBox, QDoubleSpinBox Type 2 (Source ToolBar Button Shape) */
QSpinBox[spinBoxType="sourceToolBarType"]::up-button, QDoubleSpinBox[spinBoxType="sourceToolBarType"]::up-button,
QSpinBox[spinBoxType="sourceToolBarType"]::down-button, QDoubleSpinBox[spinBoxType="sourceToolBarType"]::down-button {
	width: 16px;
	height: 16px;
    border-width: 1px;
	right: 12px;
}

QSpinBox[spinBoxType="sourceToolBarType"]::down-button, 
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::down-button {
	bottom: 1px;
}

QSpinBox[spinBoxType="sourceToolBarType"]::up-button, 
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::up-button {
	top: 1px;
}

QSpinBox[spinBoxType="sourceToolBarType"]::up-button:hover, 
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::up-button:hover,
QSpinBox[spinBoxType="sourceToolBarType"]::down-button:hover, 
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::down-button:hover {
	background-color: transparent;
}

QSpinBox[spinBoxType="sourceToolBarType"]::down-button:pressed, 
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::up-button:pressed,
QSpinBox[spinBoxType="sourceToolBarType"]::up-button:pressed, 
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::down-button:pressed {
	background-color: transparent;
}

QSpinBox[spinBoxType="sourceToolBarType"]::up-arrow,
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::up-arrow,
QSpinBox[spinBoxType="sourceToolBarType"]::down-arrow,
QDoubleSpinBox[spinBoxType="sourceToolBarType"]::down-arrow {
	width: 16px;
}

/* Common QComboBox */
QComboBox, QDateTimeEdit {
	padding-left: 12px;
	border-radius: 4px;
	background-color: #36383E;
	color: palette(text);
}

QComboBox:hover, QDateTimeEdit:hover {
	background-color: #45474C;
}

QComboBox:disabled, QDateTimeEdit:disabled {
	background-color: #202328;
	color : #757B8A;
}

QComboBox:on, QDateTimeEdit:on {
	border: 1px solid #191919;
	background-color: #36383E;
	border-bottom-left-radius: 0px;
	border-bottom-right-radius: 0px;
	color: rgba(255, 255, 255, 40%);
}

QComboBox::drop-down, QDateTimeEdit::drop-down {
	width: 40px;
	height: 40px;
	background-color: transparent;
}

QComboBox::down-arrow, QDateTimeEdit::down-arrow {
	width: 16px;
	height: 16px;
	padding: 12px;
}

QComboBox::down-arrow:enabled, QDateTimeEdit::down-arrow:enabled {
	image: url(../assets/common-component/default/combobox_dropdown.svg);
}

QComboBox::down-arrow:disabled, QDateTimeEdit::down-arrow:disabled {
	image: url(../assets/common-component/disable/combobox_dropdown.svg);
}

QComboBox QAbstractItemView {
    border: none;
	border: 1px solid #191919;
	outline: 0px;
    background: palette(window);
}

QComboBox QAbstractItemView::item {
	padding-left: 12px;
	height: 40px;
	background-color: rgba(255, 255, 255, 6%);
}

QComboBox QAbstractItemView::item:selected {
	background-color: rgba(255, 255, 255, 12%);
	color: palette(light);
}

QComboBox QAbstractItemView::item:disabled {
	color: rgba(255, 255, 255, 14%);
}

/* Common QPushButton */
QPushButton {
    border-radius: 4px;
    background-color: #505257;
	color: #FCFCFD;
}

QPushButton [pushButtonTheme=type1]{
    border-radius: 4px;
    background-color: #505257;
	color: #FCFCFD;
}
QPushButton[pushButtonTheme=type2] {
    background-color: rgba(1, 130, 255, 100%);
	color: rgba(252, 252, 253, 100%);
}
QPushButton[pushButtonTheme=type3] {
    background-color: transparent;
	color: rgba(0, 163, 255, 100%);
	border : 1px solid rgba(0, 163, 255, 100%);
}
QPushButton[pushButtonTheme=type4] {
    background-color: transparent;
	color: rgba(213, 215, 220, 100%);
	border : 1px solid rgba(117, 123, 138, 30%);
}

QPushButton[pushButtonTheme=type5] {
    background-color: #EF565F;
	color: #FFFFFF;
}

QPushButton:hover {
    background-color: #66686C;
}
QPushButton[pushButtonTheme=type1]:hover {
    background-color: #66686C;
}
QPushButton[pushButtonTheme=type2]:hover {
    background-color: rgba(52, 155, 255, 100%);
}
QPushButton[pushButtonTheme=type3]:hover {
    background-color: transparent;
	color: rgba(51, 181, 255, 100%);
	border : 1px solid rgba(51, 181, 255, 100%);
}
QPushButton[pushButtonTheme=type4]:hover {
    background-color: transparent;
	color: rgba(226, 228, 233, 100%);
	border : 1px solid rgba(94, 97, 105, 100%);
}
QPushButton[pushButtonTheme=type5]:hover {
    background-color: #F1787F;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #2D3035;
	color: #757B8A;
}
QPushButton[pushButtonTheme=type1]:pressed {
    background-color: #2D3035;
	color: #757B8A;
}
QPushButton[pushButtonTheme=type2]:pressed {
    background-color: rgba(1, 130, 255, 100%);
	color: rgba(145, 150, 161, 100%);
}
QPushButton[pushButtonTheme=type3]:pressed {
    background-color: transparent;
    border : 1px solid rgba(0, 163, 255, 100%);
	color: rgba(0, 163, 255, 100%);
}
QPushButton[pushButtonTheme=type4]:pressed {
    background-color: transparent;
    border : 1px solid rgba(117, 123, 138, 20%);
	color: rgba(117, 123, 138, 100%);
}
QPushButton[pushButtonTheme=type5]:pressed {
    background-color: #A42730;
    color: #757B8A;
}

QPushButton:disabled {
    background-color: #2D3035;
    color : #757B8A;
}
QPushButton[pushButtonTheme=type1]:disabled {
    background-color: #2D3035;
    color : #757B8A;
}
QPushButton[pushButtonTheme=type2]:disabled {
    background-color: rgba(45, 48, 53, 100%);
	color: rgba(117, 123, 138, 100%);
}
QPushButton[pushButtonTheme=type3]:disabled {
    border : 1px solid rgba(0, 163, 255, 100%);
	color: rgba(0, 163, 255, 100%);
}
QPushButton[pushButtonTheme=type4]:disabled {
    border : 1px solid rgba(117, 123, 138, 20%);
	color: rgba(117, 123, 138, 100%);
}
QPushButton[pushButtonTheme=type5]:disabled {
    background-color: #2D3035;
    color: #757B8A;
}

QPushButton:checked {
    background-color: rgba(255, 255, 255, 20%);
}

QPushButton[buttonType="coloredButton"] {
	background-color: #0182FF;
}

QPushButton[buttonType="coloredButton"]:hover {
	background-color: #349BFF;
}

QPushButton[buttonType="coloredButton"]:disabled {
	background-color: #014E99;
	color: #9196A1;
}

/* Common QRadioButton */
QRadioButton {
	color: rgba(255, 255, 255, 70%);
	font-size: 14px;
}

QRadioButton::indicator {
	width: 18px;
	height: 18px;
}

QRadioButton::indicator::checked {
	image: url("../assets/common-component/default/radiobutton_checked.svg");
}

QRadioButton::indicator::unchecked {
	image: url("../assets/common-component/default/radiobutton_unchecked.svg");
}

/* Common Title, Bottom Frame Border */
QFrame#titleFrame {
	border: none;
	border-bottom: 1px solid palette(dark);
}

QFrame#buttonBoxFrame {
	border-top : 1px solid palette(dark);
}

/* Common QDialogButtonBox */
QDialogButtonBox QPushButton {
	width : 128px;
	height : 40px;
	color: #FCFCFD;
	background-color:#505257;
}

QDialogButtonBox QPushButton:hover {
	width : 128px;
	height : 40px;
	color: #FCFCFD;
	background-color:#66686C;
}

QDialogButtonBox QPushButton:disabled {
	width : 128px;
	height : 40px;
	color: #757B8A;
	background-color:#2D3035;
}

QDialogButtonBox QPushButton:pressed {
	width : 128px;
	height : 40px;
	color: #757B8A;
	background-color:#2D3035;
}

/* Common Popup or Dock Title QLabel */
QLabel[labelType="labelTitle"] { 
	font-size:14px;
	font-weight:600;
	color: #D5D7DC;
}

QLabel[labelType="loginTitle"] {
	color: #E2E4E9;
	font-size: 14px;
	font-weight: 600;
}

QLabel[labelType="loginInfo"] {
	color: #D5D7DC;
	font-size: 14px;
	font-weight: 400;
}

QLabel[labelType="labelAddSourceComposit"] {
	color: rgba(255, 255, 255, 90%);
	font-size: 14px;
	font-weight: 700;
}

QLabel[labelType="settingBold"] {
    color: rgba(255, 255, 255, 80%);
	font-size: 18px;
	font-weight: 700;
}

QLabel[labelType="bold"] {
	font-weight: 700;
}

QLabel[labelType="alertText"] {
    font-weight: 400;
    font-size: 16px;
    text-align: center;
}

/* Vertical Three Dots Button */
QPushButton[buttonType="threeDots"] {
	background-color: transparent;
	image: url("../assets/mainview/default/three-dots.svg");
}

QPushButton[buttonType="threeDots"]:hover {
	image: url("../assets/mainview/mousehover/three-dots.svg");
}

/* Horizontal Three Dots Button */
QPushButton[buttonType="hthreeDots"] {
	image: url("../assets/mainview/default/horizontalthreedots.svg");
	background-color: transparent;
}

QPushButton[buttonType="hthreeDots"]:hover {
	image: url("../assets/mainview/mousehover/horizontalthreedots.svg");
}

/* Close Button */
QPushButton[buttonType="closeButton"] {
	image: url("../assets/mainview/default/close.svg");
	background-color: transparent;
}

QPushButton[buttonType="closeButton"]:hover{
	image: url("../assets/mainview/mousehover/close.svg");
	background-color: transparent;
}

QPushButton[buttonType="closeButton"]:disabled{
	image: url("../assets/mainview/disable/close.svg");
	background-color: transparent;
}

/*Refresh Button*/
QPushButton[buttonType="refreshButton"] {
	background-color : none;
	image: url(../assets/mainview/default/ic_refresh.svg);
}

QPushButton[buttonType="refreshButton"]:disabled {
	image: url(../assets/mainview/disable/ic_refresh.svg);
}

/* Question Mark Button */
QPushButton[buttonType="questionmarkButton"] {
	image: url("../assets/common-component/default/question_mark.svg");
	background-color: transparent;
}

QPushButton[buttonType="questionmarkButton"]:hover {
	image: url("../assets/common-component/mousehover/question_mark.svg");
}

QPushButton[buttonType="questionmarkButton"]:pressed,
QPushButton[buttonType="questionmarkButton"]:disabled {
	image: url("../assets/common-component/disable/question_mark.svg");
}

/* Add Tag Button */
QPushButton[buttonType="addTagButton"] {
	qproperty-icon: url("../assets/common-component/default/add_tag.svg");
}

/* Source List Button */
QPushButton[buttonType="sourceListToolbar"]{
    background-color: transparent;
}

/* Settings */
QPushButton[buttonType="settings"] {
	image: url("../assets/mainview/default/shortcutsettings.svg");
	border-radius: 4px;
	background-color: transparent;
}

QPushButton[buttonType="settings"]:hover {
	image: url("../assets/mainview/mousehover/shortcutsettings.svg");
}

QPushButton[buttonType="settings"]:pressed {
	image: url("../assets/mainview/pressed/shortcutsettings.svg");
}

QPushButton[buttonType="transparentsettings"] {
	image: url("../assets/mainview/default/shortcuttransparentsettings.svg");
	border-radius: 4px;
	background-color: transparent;
}

QPushButton[buttonType="transparentsettings"]:hover {
	image: url("../assets/mainview/mousehover/shortcuttransparentsettings.svg");
}

QPushButton[buttonType="settings"]:disabled {
	background-color: rgba(255, 255, 255, 0.6%);
}

/* Bottom Scene 3Dot Button */
QPushButton#bottomSceneDotButton {
	background: transparent;
	border: 1px solid palette(mid);
	border-radius: 5px;
}

QPushButton#bottomSceneDotButton:hover {
    background-color: rgba(255, 255, 255, 20%);
}
QPushButton#bottomSceneDotButton:pressed {
    background-color: #26292F;
}

/* Filter Popup */
.indicator-visibility::indicator:checked:enabled,
.indicator-visibility::indicator:checked:disabled {
	image: url("../assets/Popup/basicFilter/btn_filter_show.svg");
}

.indicator-visibility::indicator:unchecked:enabled,
.indicator-visibility::indicator:unchecked:disabled {
	image: url("../assets/Popup/basicFilter/btn_filter_hide.svg");
}

/* Custom Icon QPushButton */
QPushButton[themeID="addIconSmall"] {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_add_source.svg);
}

QPushButton[themeID="addIconSmall"]:hover {
