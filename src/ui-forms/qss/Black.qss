    image: url(../assets/scene-source-block/source-control/bt_add_source_hover.svg);
}

QPushButton[themeID="removeIconSmall"] {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_remove_source.svg);
}

QPushButton[themeID="removeIconSmall"]:hover {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_remove_source_hover.svg);
}

QPushButton[themeID="configIconSmall"] {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_props_source.svg);
}

QPushButton[themeID="configIconSmall"]:hover {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_props_source_hover.svg);
}

QPushButton[themeID="upArrowIconSmall"] {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_move_up_source.svg);
}

QPushButton[themeID="upArrowIconSmall"]:hover {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_move_up_source_hover.svg);
}

QPushButton[themeID="downArrowIconSmall"] {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_move_down_source.svg);
}

QPushButton[themeID="downArrowIconSmall"]:hover {
    background-color:transparent;
    image: url(../assets/scene-source-block/source-control/bt_move_down_source_hover.svg);
}

AFQMessageBox #label_MessageBoxTitle {
	color: #FCFCFD;
	font-size: 17px;
	font-style: normal;
	font-weight: 600;
}


AFQMessageBox #label_MessageBoxText {
	font-size: 16px;
}

AFQMessageBox #label_SmallMessageBoxText {
	font-size: 14px;
}

