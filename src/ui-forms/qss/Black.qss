}

AFAdvanceControlsWidget QLabel[AdvControlWdtStyle="basicMode"] {
	background-color:transparent; 
	border-image: url("../assets/advance-controls-block/studio-mode.svg") 0 0 0 0 stretch stretch;
}

AFAdvanceControlsWidget QLabel[AdvControlWdtStyle="basicMode-pressed"],
AFAdvanceControlsWidget QLabel[AdvControlWdtStyle="basicMode"]:disabled {
	border-image: url("../assets/advance-controls-block/studio-mode-disabled.svg") 0 0 0 0 stretch stretch;
}

/* Advance Control ReplayBuffer Icon */
