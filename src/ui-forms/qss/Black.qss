}

AFQSelectSourceDialog #label_ScreenComposit,
AFQSelectSourceDialog #label_AudioComposit,
AFQSelectSourceDialog #label_EtcComposit,
AFQSelectSourceDialog #label_AquaComposit,
AFQSelectSourceDialog #label_SoopEtcComposit,
AFQSelectSourceDialog #label_KboComposit,
AFQSelectSourceDialog #label_FootballComposit,
AFQSelectSourceDialog #label_LivecommerceComposit { 
