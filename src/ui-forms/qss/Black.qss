}

AFQSelectSourceDialog #pushButton_BasicSource[tabButtonType="clicked"],
AFQSelectSourceDialog #pushButton_SoopSource[tabButtonType="clicked"] {
    color: #00A3FF;
    background-color: rgb(36,39,46);
