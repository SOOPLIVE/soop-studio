/* Balloon Widget */
AFQBalloonWidget #widget_Border {
	background-color: palette(mid);
	border-radius: 6px;
}

AFQBalloonWidget #widget_Contents {
	background-color: palette(window);
	border-radius: 6px;
}

AFQBalloonWidget QLabel {
	color: #DDD;
	font-size: 13px;
}

AFQBalloonWidget #label_balloonPoint {
	image: url("../assets/Popup/balloon-point.svg") 0 0 0 0 stretch;
	margin: 0px;
}

/* Dock Title */
AFDockTitle, AFDockTitle[dock="false"][dockable="false"]{
	background: palette(window);
	border-left: none;
	border-right: none;
	border-top: 0px solid #000;
	border-bottom: 1px solid #000;
}

AFDockTitle, AFDockTitle[dock="false"][dockable="true"] {
	background: palette(window);
	border: none;
}

AFDockTitle #label_BlockIcon[blockType="AudioMixer"] {
		image: url("../assets/audio-mixer-block/ic_audio_mixer.svg");
}

AFDockTitle #label_BlockIcon[blockType="SceneSource"] {
		image: url("../assets/scene-source-block/ic_scene_source.svg");
}

AFDockTitle #label_BlockIcon[blockType="BroadInfo"] {
		image: url("../assets/broad-info-block/icon_Live.svg");
}

/* Dock Title Border */
AFDockTitle[dock="true"][floating="true"][pressed="true"] {
	border-top-left-radius: 0px;
	border-top-right-radius: 0px;
	border-left: 1px solid palette(light);
	border-right: 1px solid palette(light);
	border-top: 1px solid palette(light);
}

AFDockTitle[dock="true"][floating="false"][pressed="true"] {
	border-top-left-radius: 10px;	
	border-top-right-radius: 10px;
	border-left: 1px solid palette(light);	
	border-right: 1px solid palette(light);	
	border-top: 1px solid palette(light);
}

AFDockTitle[dock="true"][floating="true"][pressed="false"] {
	border-top-left-radius: 0px;	
	border-top-right-radius: 0px;
	border-left: 1px solid palette(dark);		
	border-right: 1px solid palette(dark);	
	border-top: 1px solid palette(dark);
}

AFDockTitle[dock="true"][floating="false"][pressed="false"] {
	border-top-left-radius: 10px;	
	border-top-right-radius: 10px;
	border-top: 1px solid black;
}

AFDockTitle #label {
	font-size: 15px;
	font-weight: 500;
	color : palette(text);
}

AFDockTitle #pushButton_FAQ {
	border: 1px;
	border-radius: 12px;
	background: #36383E;
	font-size: 11px;
}


/* Popup Contents */
#dockPopupContainer {
	background-color: palette(window);
	border: 1px solid palette(dark);
}

/* Dock Contents */
#widget_DockGap, #dockContainer {
	background-color: palette(window);
}

#widget_DockGap[dock="false"],
#dockContainer[dock="false"] {
	border: none;
	border-top-right-radius: 0px;
	border-bottom-right-radius: 10px;
	border-top-left-radius: 0px;
	border-bottom-left-radius: 10px;
}

#widget_DockGap[dock="true"][floating="true"][pressed="true"],
#dockContainer[dock="true"][floating="true"][pressed="true"] {
	border-bottom-right-radius: 0px;
	border-bottom-left-radius: 0px;
	border: 1px solid palette(light);
	border-top: none;
}

#widget_DockGap[dock="true"][floating="false"][pressed="true"],
#dockContainer[dock="true"][floating="false"][pressed="true"] {
	border-bottom-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border: 1px solid palette(light);
	border-top: none;
}

#widget_DockGap[dock="true"][floating="true"][pressed="false"],
#dockContainer[dock="true"][floating="true"][pressed="false"] {
	border-bottom-right-radius: 0px;
	border-bottom-left-radius: 0px;
	border: 1px solid palette(dark);
	border-top: none;
}

#widget_DockGap[dock="true"][floating="false"][pressed="false"][tabbed="true"],
#dockContainer[dock="true"][floating="false"][pressed="false"][tabbed="true"] {
	border-top: none;
	border-bottom: none;
	border-bottom-right-radius: 10px;
}
#widget_DockGap[dock="true"][floating="false"][pressed="false"][tabbed="false"],
#dockContainer[dock="true"][floating="false"][pressed="false"][tabbed="false"] {
	border-top: none;
	border-bottom: none;
	border-bottom-right-radius: 10px;
	border-bottom-left-radius: 10px;
}

QPushButton[buttonType="StudioMode"][isShow="false"]{
	image: url("../assets/block-icon/popup/default/studiomode.svg");
	background-color: transparent;
}

QPushButton[buttonType="StudioMode"][isShow="false"]:hover {
	image: url("../assets/block-icon/popup/hover/studiomode.svg");
}

QPushButton[buttonType="StudioMode"][isShow="false"]:pressed {
