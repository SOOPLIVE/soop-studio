	font-size: 18px;
}

/* MainFrame */
AFMainFrame {
	background: palette(shadow);
}

AFMainFrame #frame_Bottom {
	background: palette(window);
	border-bottom: 1px solid palette(dark);
	border-top: 1px solid palette(dark);
}

AFMainFrame #widget_Top {
	background-color: palette(window);
}

AFMainFrame #label_SoopStudio {
	image: url("../assets/mainview/freecshot_plus_logo.svg");
}

AFMainFrame #pushButton_Sarsa { 
	background-color: transparent;
}
AFMainFrame #pushButton_Sarsa:checked { 
	background-color: transparent;
}

AFMainFrame #pushButton_Event {
	background-color: transparent;
	image: url("../assets/mainview/default/Eventbanner.png");	
}

AFMainFrame #pushButton_Event:hover {
	background-color: transparent;
	image: url("../assets/mainview/mousehover/Eventbanner.png");	
}


AFMainFrame #pushButton_Event:pressed {
	background-color: transparent;
	image: url("../assets/mainview/pressed/Eventbanner.png");	
}

/* Prompt Tooltip */
AFQPromptTooltip #sarsa_prompt {
	background-color: transparent;
	padding-left: 5px;
    padding-right: 5px;
    padding-bottom: 0px;
    padding-top: 0px;
}
AFQPromptTooltip #prompt_label {
	color: #FCFCFD;
	font-size: 14px;
}
AFQPromptTooltip QPushButton {
	background-color : transparent;
    border-radius: 15px;
    border: 1px solid #0182FF;
	padding: 0px 10px 1px 10px;
	color : #0182FF;
}
AFQPromptTooltip QPushButton:hover {
	background-color: rgba(255, 255, 255, 11%);
}
AFQPromptTooltip QPushButton:pressed,
AFQPromptTooltip QPushButton:disabled {
	background-color : #2D3035;
}

AFMainFrame #line_TopControl,
AFMainFrame #line_Time {
	background-color: rgba(255, 255, 255, 10%)
}

AFMainFrame #pushButton_Broad[IsLive="false"] {
	border-radius: 15px;
	background: qlineargradient( x1:0 y1:0, x2:1 y2:0, stop:0 #0182FF , stop:1 #00E0FF );
	color: white;	
	font-size: 14px;
	font-weight: 700;
	padding-left: 1px;
}

AFMainFrame #pushButton_Broad[IsLive="false"]:hover {
	border-radius: 15px;
	background-color: #D1FF01;
}

AFMainFrame #pushButton_Broad[IsLive="false"]:hover {
	border-radius: 15px;
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #198EFF, stop:1 #80F3FF);
}

AFMainFrame #pushButton_Broad[IsLive="true"] {
	border-radius: 15px;
	background-color: #FF2424;
	color: rgba(255, 255, 255, 100%);
	padding-top: -1px;
}

AFMainFrame #pushButton_Broad[IsLive="true"]:hover {
	border-radius: 15px;
	background-color: #FF4545;
	padding-top: -1px;
}

AFMainFrame #pushButton_Broad:disabled {
	background: qlineargradient( x1:0 y1:0, x2:1 y2:0, stop:0 rgba(56,147,255,10%), stop:1 rgba(14,227,241,10%));
	color: rgba(255, 255, 255, 10%);
}

AFMainFrame #pushButton_Record{
	border-radius: 15px;
	background-color: #505257;
	color: rgba(255, 255, 255, 70%);
	font-size: 13px;
	padding-left: 1px;
}

AFMainFrame #pushButton_Record[IsRec="false"] {
	border-radius: 15px;
    background-color: rgba(255, 255, 255, 10%);
    color: rgba(255, 255, 255, 80%);
	font-size: 13px;
	font-weight: 400;
}

AFMainFrame #pushButton_Record:hover {
	color: rgb(255, 255, 255);
	font-size: 13px;
}

AFMainFrame #pushButton_Record[IsRec="false"]:hover{
	background-color: #66686C;
	font-size: 13px;
}

AFMainFrame #pushButton_Record[IsRec="true"] {
	border: 1px solid #614d28;
	background: transparent;
	color: #EEA61B;
	font-size: 13px;
	font-weight: 700;
}

AFMainFrame #pushButton_Record[IsRec="true"]:hover {
	border: 1px solid #EEA61B;
	font-size: 13px;
}

AFMainFrame #pushButton_Record:disabled {
	background: qlineargradient( x1:0 y1:0, x2:1 y2:0, stop:0 rgba(56,147,255,10%), stop:1 rgba(14,227,241,10%));
	color: rgba(255, 255, 255, 10%);
	font-weight: 700;
}

AFMainFrame #widget_BottomBroad {
