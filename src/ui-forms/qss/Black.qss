	border-bottom: none;
	border-left: none;
	border-right: none;
}

AFQSelectSourceDialog #line, AFQSelectSourceDialog #line_2 {
	background: palette(dark);
}

AFQSelectSourceDialog AFQSelectSourceButton {
	border-radius: 5px;
	border: 1px solid palette(mid);
	color:#BDBEC0;
	background:transparent;
}

AFQSelectSourceDialog AFQSelectSourceButton:hover {
	border: 1px solid rgba(0, 224, 255, 10%);
	color : #FFFFFF;
	background-color: #0182FF;
}

AFQSelectSourceDialog AFQSelectSourceButton:press {
	border: 1px solid palette(mid);
}

AFQSelectSourceButton QLabel {
	color: midlight;
	text-align: center;
	font-size: 14px;
}

AFQSelectSourceButton #label_SourceBtnText[buttonState='idle'] {
	color: rgba(255, 255, 255, 70%);
}

AFQSelectSourceButton #label_SourceBtnText[buttonState='hover'] {
	color: rgba(255, 255, 255, 100%);
}

AFQSelectSourceButton #label_SourceBtnText[buttonState='press'] {
	color: #a7a9ab;
}

/* Slider Frame */
AFQSliderFrame {
	background-color: #2D3035;
	border: 1px solid palette(dark);
}

AFQSliderFrame QSlider::groove:vertical {
	width: 3px;
	border-radius: 1px;
    background-color: #505257;
    left: 4px; 
	right: 4px;
}

AFQSliderFrame QSlider::handle:vertical {
	width: 11px;
	height: 0px;
	image: none;
	background-color: transparent;
	margin: 0px 0px;
}

AFQSliderFrame QSlider[sliderState="hover"]::handle:vertical {
	height: 11px;
	image: url("../assets/mainview/mousehover/volumehandle.svg") no-repeat center center fixed;
	margin: 0px -5px;
}

AFQSliderFrame QSlider[sliderState="pressed"]::handle:vertical {
	height: 11px;
	image: url("../assets/mainview/pressed/volumehandle.svg") no-repeat center center fixed;
	margin: 0px -5px;
}

AFQSliderFrame QSlider[Mute="false"]::add-page:vertical {
    width: 3px;
	border-radius: 1px;
	background-color: #D3D4D5;
}

AFQSliderFrame QSlider[Mute="false"][sliderState="hover"]::add-page:vertical,
AFQSliderFrame QSlider[Mute="false"][sliderState="pressed"]::add-page:vertical {
	background-color: #FCFCFD;
}

AFQSliderFrame QSlider[Mute="true"]::add-page:vertical {
    width: 3px;
	border-radius: 1px;
	background-color: rgba(252, 255, 255, 40%);
}

AFQSliderFrame QSlider::handle:vertical:disabled {
    width: 0px;
	height: 0px;
	image: none;
	background-color: transparent;
	margin: 0px;
}

/* Source Properites */
QGroupBox {
    background: transparent;
    border : none;
    padding-top: 22px;
    padding-bottom: 12px;
    margin-top: 14px;
    margin-bottom: 4px;
}

QGroupBox::title {
	font-size:14px;
}

QGroupBox::indicator {
	width: 18px;
	height: 18px;
}

QGroupBox::indicator:unchecked:enabled {
	image: url(../assets/common-component/default/checkbox_unchecked.svg);
}

QGroupBox::indicator:unchecked:hover {
	image: url(../assets/common-component/mousehover/checkbox_unchecked.svg);
}

QGroupBox::indicator:unchecked:disabled {
	image: url(../assets/common-component/disable/checkbox_unchecked.svg);
}

QGroupBox::indicator:checked:enabled {
	image: url(../assets/common-component/default/checkbox_checked.svg);
}

QGroupBox::indicator:checked:hover {
	image: url(../assets/common-component/mousehover/checkbox_checked.svg);
}

QGroupBox::indicator:checked:disabled {
	image: url(../assets/common-component/disable/checkbox_checked.svg);
}

