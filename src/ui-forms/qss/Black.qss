AFBreaktime #pushButton_breaktime_edit_2:pressed {
	background-color: transparent;
	image: url(../assets/broad-info-block/pressed/bt_edit_title.svg);
}

AFBreaktime #listWidget_breaktime {
	padding: 8px;
	font-size : 14px;
}

AFBreaktime #listWidget_breaktime::item {
    padding: 9px;
}

AFBreaktime #pushButton_breaktime_preview{
	background-color: transparent;	
	border-radius: 6px;
	border: 1px solid rgba(117, 123, 138, 20%);
}

AFBreaktime #pushButton_breaktime_preview:hover{
	background-color: transparent;
	border-radius: 6px;
	border: 1px solid #464A53;
}

AFBreaktime #pushButton_breaktime_preview:pressed{
	background-color: transparent;
	border-radius: 6px;
	border: 1px solid rgba(117, 123, 138, 20%);
}

AFBreaktime #pushButton_breaktime_preview:disabled{
	background-color: transparent;
	border-radius: 6px;
	border: 1px solid rgba(117, 123, 138, 20%);
}

AFBreaktime #horizontalSlider_breaktime:groove:horizontal:disabled {
	background-color: #000000;
}

AFBreaktime #horizontalSlider_breaktime:sub-page:horizontal:disabled {
	background-color: #000000;
}

AFBreaktime #horizontalSlider_breaktime_2:groove:horizontal:disabled {
	background-color: #000000;
}

AFBreaktime #horizontalSlider_breaktime_2:sub-page:horizontal:disabled {
	background-color: #000000;
}

AFDockTitle #widget_breaktime {
	background-color: rgba(23, 25, 28, 40%);
	border: 1px solid #4A4B50;
	border-radius: 10px;
}

AFDockTitle #label_breaktime_title {
	background-color: transparent;
	font-size: 12px;
	color : #D5D7DC;
}

AFDockTitle #label_breaktime_time {
	background-color: transparent;
	font-size: 12px;
	color : #44A3FF;
	font-weight: 600;
}

AFQAIManagerDialog #label_AIManagerInfo {
    font-weight: 400;
    font-style: Regular;
    font-size: 15px;
    color: #D5D7DC;
}

AFQAIManagerDialog #label_TimeInfo,
AFQAIManagerDialog #label_SourceInfo {
    font-weight: 400;
    font-style: Regular;
    font-size: 15px;
    color: #9196A1;
}

AFQAIManagerDialog #label_TimeTitle,
AFQAIManagerDialog #label_SourceTitle {
    font-weight: 600;
    font-style: SemiBold;
    font-size: 15px;
    color: #FCFCFD;
}

AFQAIManagerDialog #label_Title {
    font-weight: 500;
    font-style: Medium;
    font-size: 15px;
    color: #D5D7DC;
}

AFQAIManagerDialog #pushButton_Delete,
AFQAIManagerDialog #pushButton_Refresh {
    font-weight: 400;
    font-style: Regular;
    font-size: 14px;
    text-align: center;
}

AFQAIManagerDialog #widget_Top {
    border-bottom: 1px solid palette(dark);
}

StartingAIManagerWidget #widget_Contents {
    border-bottom: 1px solid palette(dark);
    border-left: 1px solid palette(dark);
    border-right: 1px solid palette(dark);
}

StartingAIManagerWidget #widget_Top {
    border-top: 1px solid palette(dark);
    border-left: 1px solid palette(dark);
    border-right: 1px solid palette(dark);
}

StartingAIManagerWidget #label_AIStarting {
    border-bottom: 1px solid palette(dark);
}

StartingAIManagerWidget #widget_Background {
    background-image: url("../assets/ai_manager/ai_manager_background.png");
}

StartingAIManagerWidget #widget_Top {
    background: transparent;
}