	background-color: transparent;
	image: url(../assets/platform/default/addplatform.png);
}
AFQLeftNavigationBar QPushButton[buttonType="addPlatform"]:disabled{
	background-color: transparent;
	image: url(../assets/platform/disable/addplatform.png);
}

AFQLeftNavigationBar QPushButton[buttonType="leftBarExtraMenu"] {
	border-radius : 10px;
	image: url(../assets/mainview/leftsidebar/bt_leftbar_menu_off.svg);
}

AFQLeftNavigationBar QPushButton[buttonType="leftBarExtraMenu"]:hover,
AFQLeftNavigationBar QPushButton[buttonType="leftBarExtraMenu"]:checked:hover {
	background-color: #3A3D42;
}

AFQLeftNavigationBar QPushButton[buttonType="leftBarExtraMenu"]:checked {
	background-color: transparent;
	image: url(../assets/mainview/leftsidebar/bt_leftbar_menu_on.svg);
}

QPushButton[buttonType="favoriteMenuButton"]:hover {
	background-color: #3A3D42;
}

AFQLeftNavigationBar #widget_MainChannel {
	border-top: 1px solid black;
	background-color: #24272D;
	border-right: 1px solid black;
	image: url(../assets/mainview/leftsidebar/ic_main_channel_dot.svg);
}

